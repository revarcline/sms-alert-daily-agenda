# ── Google Calendar OAuth ────────────────────────────────────────────────────
# Path to the OAuth 2.0 client credentials JSON downloaded from Google Cloud Console.
GOOGLE_CREDENTIALS_FILE=/home/YOUR_USER/agenda/credentials.json

# Path where the token will be stored after first authentication.
GOOGLE_TOKEN_FILE=/home/YOUR_USER/agenda/token.json

# ── SMTP (email-to-SMS) ───────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
# Use an app password, not your account password.
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Recipient ─────────────────────────────────────────────────────────────────
PHONE_NUMBER=5551234567
# Carrier name (case-insensitive). Supported: tmobile, att, verizon, sprint,
# boost, cricket, metro/metropcs, uscellular, virgin, googlefi/fi.
CARRIER=tmobile

# ── Calendar selection ────────────────────────────────────────────────────────
# Comma-separated list of calendar IDs. Use "primary" for the primary calendar.
CALENDAR_IDS=primary

# Set to "true" to send one SMS thread per calendar instead of combining them.
# PER_CALENDAR=false

# ── Timing ────────────────────────────────────────────────────────────────────
# IANA timezone name for the agenda (e.g. America/New_York, America/Chicago).
TIMEZONE=America/Chicago

# How many days ahead to include one-off (non-recurring) future events.
LOOKAHEAD_DAYS=7

# How many weeks back to scan when checking if an event is recurring.
RECURRING_CHECK_WEEKS=4

# Override the agenda date (YYYY-MM-DD). Leave unset to use today.
# AGENDA_DATE=2026-01-15
